# Census Employment RAG - Environment Configuration
# Copy this file to .env and fill in your values

# Census Bureau API Key (Required)
# Get your key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# LLM Provider API Keys (Optional - needed for natural language responses)

# Anthropic Claude API Key
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key (alternative to Anthropic)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Default LLM Provider (anthropic or openai)
DEFAULT_LLM_PROVIDER=anthropic

# Path to Census MCP Server (Optional)
# If you've cloned the official MCP server locally
# CENSUS_MCP_PATH=/path/to/us-census-bureau-data-api-mcp

# Cache Configuration
CACHE_ENABLED=true
CACHE_DIR=data/cache

# Vector Database Configuration
VECTOR_DB_DIR=data/vectordb
